generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String         @id @default(cuid())
  email      String         @unique
  name       String?
  password   String         @default("admin123")
  role       String         @default("CONSULTANT") // "CONSULTANT", "MANAGER", "FIELD_WORKER"
  hourlyRate Float?         @default(35.0) // Used for FIELD_WORKER payroll calculation (e.g., 35.00)
  avatarUrl  String?
  leads      Lead[]
  emails     EmailMessage[]
  timeLogs   TimeLog[]
  createdAt  DateTime       @default(now())
}

model CampaignMetrics {
  id                    String   @id @default(cuid())
  date                  DateTime
  campaignId            String
  campaignName          String
  status                String   @default("ENABLED") // ENABLED, PAUSED, REMOVED
  advertisingChannel    String   @default("SEARCH") // SEARCH, DISPLAY, PERFORMANCE_MAX, VIDEO
  impressions           Int
  clicks                Int
  cost                  Float    // Total spend
  conversions           Float
  conversionValue       Float    // Conversion value / revenue
  ctr                   Float    // Click-through rate (%)
  averageCpc            Float    // Average Cost Per Click
  costPerConversion     Float    // Cost Per Acquisition (CPA)
  roas                  Float    // Return on Ad Spend (value / cost)
  searchImpressionShare Float    @default(0) // Impression share percentage
  createdAt             DateTime @default(now())

  @@index([campaignId])
  @@index([date])
}

model KeywordMetrics {
  id           String   @id @default(cuid())
  campaignId   String
  keyword      String
  matchType    String   // EXACT, PHRASE, BROAD
  impressions  Int
  clicks       Int
  cost         Float
  conversions  Float
  cpc          Float
  qualityScore Int?
  createdAt    DateTime @default(now())

  @@index([campaignId])
}

model AiConsultation {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  promptType       String   @default("AUDIT") // AUDIT, BID_OPTIMIZATION, COPYWRITING, NEGATIVE_KEYWORDS
  contextData      String   // JSON string of campaign/keyword data analyzed
  aiRecommendation String   // Markdown recommendation from Gemini
  createdAt        DateTime @default(now())
}

model AccountSetting {
  id           String    @id @default(cuid())
  customerId   String    @unique
  accountName  String
  currency     String    @default("USD")
  timeZone     String    @default("America/New_York")
  isDemo       Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Lead {
  id                String    @id @default(cuid())
  source            String    // GOOGLE_ADS, GOOGLE_LSA, GOOGLE_BUSINESS, ORGANIC, DIRECT
  campaignId        String?
  campaignName      String?
  
  // ValueTrack, UTM Attribution & Omnichannel Tracking
  keyword           String?   // Exact search term from Google
  gclid             String?   // Google Click ID for Offline Conversion tracking
  fbclid            String?   // Facebook Click ID
  utmSource         String?   // GOOGLE, META_FACEBOOK, META_INSTAGRAM, MICROSOFT_BING, TIKTOK, ORGANIC
  utmMedium         String?   // cpc, lead_ad, social, organic
  utmCampaign       String?   // Campaign name or ID
  matchType         String?   // Exact (e), Phrase (p), Broad (b)
  device            String?   // Mobile (m), Desktop (c), Tablet (t)
  city              String?
  state             String?

  // Contact Info & US Legal Compliance
  name              String
  email             String?
  phone             String?
  address           String?
  zipCode           String?
  tcpaConsent       Boolean   @default(true) // Telephone Consumer Protection Act opt-in
  serviceInterested String?   // e.g. "Pintura Externa", "Armários de Cozinha", "Pintura Comercial"
  serviceType       String?   // US service category
  tags              String?   @default("[]") // JSON string of tags: ["lead_convertido", "orcamento_enviado"]
  stripeCheckoutUrl String?   // Dynamic Stripe payment checkout link
  stripePaymentStatus String? @default("UNPAID") // UNPAID, PENDING, PAID
  
  // Pipeline, Ownership & Speed-to-Lead Gamification
  status            String    @default("NOVO") // NOVO, EM_ATENDIMENTO, PROPOSTA, CONVERTIDO, EM_EXECUCAO, FINALIZADO, PERDIDO
  portalToken       String?   @unique
  referralToken     String?   @unique // Link exclusivo de indicação do cliente com cashback
  netProfit         Float?    // Job Costing: dealValue - (materials + labor)
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id])
  
  // Timing & Financial SLA Metrics
  claimedAt         DateTime? // Exact time a consultant grabbed the lead (speed-to-lead SLA)
  closedAt          DateTime? // Time the deal was won/lost
  dealValue         Float?    // Monetary deal value in USD ($)
  
  notes             String?
  aiScore           Int?      // 1 to 10
  aiQualification   String?   // Gemini summary of lead intent
  whatsappScript    String?   // Suggested WhatsApp/SMS message generated by Gemini
  rawData           String    @default("{}") // JSON string of full payload received
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appointments      Appointment[]
  contracts         Contract[]
  reviewRequests    ReviewRequest[]
  emails            EmailMessage[]
  media             Media[]
  timeLogs          TimeLog[]
  materialOrders    MaterialOrder[]
  permits           PermitCompliance[]
  estimates         Estimate[]
  chatMessages      ChatMessage[]
  dispatchTrackers  DispatchTracker[]
  mctbTriggered     Boolean           @default(false)
  mctbStatus        String?           // TRIGGERED, ENGAGED, SCHEDULED

  @@index([source])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
  @@index([portalToken])
  @@index([referralToken])
}

model Media {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  url        String   // S3 Bucket URL ou upload local
  type       String   // 'FOTO_ORIGINAL', 'RENDER_DALLE', 'PROGRESSO_OBRA'
  isPublic   Boolean  @default(false) // Visível no Portal do Cliente?
  aiAnalysis String?  // Dados de estimativa (metragem, materiais, galões de tinta) em JSON
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model TimeLog {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  checkIn       DateTime  @default(now())
  checkOut      DateTime?
  gpsLat        Float?
  gpsLng        Float?
  isValidated   Boolean   @default(false) // Validado via Geofencing
  lunchDeducted Boolean   @default(true) // Automatically deducts 30 mins (0.5h) for lunch
  totalHours    Float?    // Net decimal hours worked (after lunch deduction)
  earnedPay     Float?    // totalHours * user.hourlyRate
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([leadId])
}

model MaterialOrder {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  item      String   // Ex: Galão de Tinta Sherwin-Williams Emerald
  quantity  Float
  unit      String   @default("galões") // galões, rolos, caixas, unidades
  unitCost  Float    @default(0)
  totalCost Float    @default(0)
  status    String   @default("PENDING") // 'PENDING', 'PURCHASED'
  supplier  String?  @default("Sherwin-Williams")
  createdAt DateTime @default(now())

  @@index([leadId])
}

model CallLog {
  id              String   @id @default(cuid())
  leadId          String
  agentId         String
  agentName       String?
  durationSeconds Int
  recordingUrl    String?
  aiTranscript    String?  // Call transcript & summary from Gemini
  sentiment       String?  // POSITIVE, NEUTRAL, OBJECTION
  isAiRescue      Boolean  @default(false) // Triggered automatically when SLA exceeds 2 minutes
  rescueReason    String?  // 'SLA_BREACH_OVER_2_MIN'
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([agentId])
  @@index([isAiRescue])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CLAIM_LEAD, STATUS_CHANGE, DEAL_WON, TCPA_RECORD
  userId    String
  userName  String?
  details   String   // JSON string with details of what changed
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model Appointment {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title           String?  // e.g. "Free In-Home Estimate - Exterior Painting"
  date            DateTime
  durationMinutes Int      @default(60)
  status          String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  address         String?
  notes           String?
  reminderSent    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([leadId])
  @@index([date])
}

model Contract {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractNumber   String    @unique
  title            String    // "Residential Painting Agreement - MA HIC Compliant"
  scopeOfWork      String    // Detailed scope (Prep, Sanding, Primer, 2 Coats)
  totalAmount      Float     // Total in USD
  depositAmount    Float     // Initial deposit (Max 1/3 under MA Law)
  status           String    @default("DRAFT") // DRAFT, SENT, SIGNED, PAID, CANCELLED
  documentUrl      String?
  signed           Boolean   @default(false)
  signedAt         DateTime?
  signerName       String?
  signerIp         String?
  signatureData    String?   // Base64 signature image or digital signature hash
  stripeSessionId  String?
  stripePaymentUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([leadId])
}

model ReviewRequest {
  id                 String   @id @default(cuid())
  leadId             String
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  token              String?  @unique // /review/[token]
  channel            String   @default("SMS") // SMS, EMAIL, BOTH
  googleReviewLink   String
  rating             Int?     // 1 to 5 stars
  feedbackText       String?  // Internal feedback if rating is 1, 2 or 3
  redirectedToGoogle Boolean  @default(false)
  managerAlertSent   Boolean  @default(false)
  status             String   @default("SENT") // SENT, RATED_GOOGLE, RATED_INTERNAL, CLICKED
  sentAt             DateTime @default(now())

  @@index([leadId])
  @@index([token])
}

model EmailMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  direction String   // 'INBOUND' ou 'OUTBOUND'
  folder    String   @default("INBOX") // INBOX, SENT, STARRED, DRAFTS, TRASH
  from      String
  to        String
  subject   String
  body      String
  read      Boolean  @default(false)
  starred   Boolean  @default(false)
  messageId String?  // Amazon SES message ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([leadId])
  @@index([folder])
  @@index([createdAt])
}

model PermitCompliance {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  city           String
  requiresPermit Boolean  @default(false)
  status         String   @default("PENDING") // 'PENDING', 'APPROVED', 'EXEMPT'
  permitType     String?  // 'BUILDING_PERMIT', 'HISTORIC_DISTRICT', 'EPA_LEAD_SAFE'
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([leadId])
}

model Estimate {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  token            String    @unique // /estimate/[token]
  title            String    @default("Proposta de Pintura & Reforma Residencial")
  status           String    @default("SENT") // DRAFT, SENT, ACCEPTED, DECLINED
  selectedTier     String    @default("BETTER") // GOOD, BETTER, BEST
  
  // Tier Good (Bronze Standard)
  goodTitle        String    @default("Bronze Standard")
  goodPrice        Float     @default(5400.0)
  goodScope        String    @default("1 Demão de Tinta Duration, raspagem e lixamento básico, calafetação essencial e 1 ano de garantia.")
  
  // Tier Better (Silver Signature)
  betterTitle      String    @default("Silver Signature (Recomendado)")
  betterPrice      Float     @default(7800.0)
  betterScope      String    @default("Lavagem de alta pressão, raspagem total, primer nas manchas, 2 demãos de Sherwin-Williams Emerald, calafetação completa de janelas e 3 anos de garantia.")
  
  // Tier Best (Gold Presidential)
  bestTitle        String    @default("Gold Presidential Luxury")
  bestPrice        Float     @default(10900.0)
  bestScope        String    @default("Tudo do Silver + Tinta autonivelante Rain Refresh, acabamento acetinado nos rodapés/calhas, pintura de portas decorativas e 7 anos de garantia com retoque anual grátis.")
  
  // Add-ons JSON
  addonsJson       String    @default("[{\"id\":\"front_door\",\"title\":\"Pintura da Porta de Entrada High-Gloss\",\"price\":450,\"selected\":false},{\"id\":\"deck_stain\",\"title\":\"Verniz e Restauração do Deck de Madeira\",\"price\":1600,\"selected\":false},{\"id\":\"drywall_repair\",\"title\":\"Reparo de Rachaduras de Drywall\",\"price\":750,\"selected\":false}]")
  
  totalAmount      Float     @default(7800.0)
  depositAmount    Float     @default(2600.0) // Max 1/3 (33.33%) MA Law
  
  signerName       String?
  signatureData    String?   // Base64 digital signature
  signedAt         DateTime?
  
  stripeSessionId  String?
  stripePaymentUrl String?
  stripeStatus     String?   @default("UNPAID") // UNPAID, PAID
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([leadId])
  @@index([token])
}

model ChatMessage {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel     String   // 'SMS', 'EMAIL', 'CALL_RECORDING', 'INTERNAL_NOTE'
  direction   String   @default("OUTBOUND") // 'INBOUND', 'OUTBOUND'
  from        String?
  to          String?
  subject     String?
  body        String
  audioUrl    String?  // If CALL_RECORDING
  aiGenerated Boolean  @default(false)
  status      String   @default("DELIVERED") // SENT, DELIVERED, RECEIVED, FAILED
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([channel])
  @@index([createdAt])
}

model DispatchTracker {
  id                 String    @id @default(cuid())
  leadId             String
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  token              String    @unique // /track/[token]
  technicianName     String    @default("Marcos Silva")
  technicianRole     String    @default("Consultor Técnico & Estimador")
  technicianPhoto    String?   @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&h=200&fit=crop")
  technicianPhone    String?   @default("+1 (617) 555-0199")
  licenseNumber      String    @default("MA HIC #192847")
  vehicleDescription String    @default("Van Ford Transit Branca #04 - Tony's Remodeling")
  status             String    @default("DISPATCHED") // DISPATCHED, ARRIVED, COMPLETED
  currentLat         Float     @default(42.3601)
  currentLng         Float     @default(-71.0589)
  destAddress        String?
  destLat            Float?
  destLng            Float?
  etaMinutes         Int       @default(14)
  dispatchedAt       DateTime  @default(now())
  arrivedAt          DateTime?
  updatedAt          DateTime  @updatedAt

  @@index([leadId])
  @@index([token])
}



