generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      String    @default("CONSULTANT") // "CONSULTANT" or "MANAGER"
  leads     Lead[]
  createdAt DateTime  @default(now())
}

model CampaignMetrics {
  id                    String   @id @default(cuid())
  date                  DateTime
  campaignId            String
  campaignName          String
  status                String   @default("ENABLED") // ENABLED, PAUSED, REMOVED
  advertisingChannel    String   @default("SEARCH") // SEARCH, DISPLAY, PERFORMANCE_MAX, VIDEO
  impressions           Int
  clicks                Int
  cost                  Float    // Total spend
  conversions           Float
  conversionValue       Float    // Conversion value / revenue
  ctr                   Float    // Click-through rate (%)
  averageCpc            Float    // Average Cost Per Click
  costPerConversion     Float    // Cost Per Acquisition (CPA)
  roas                  Float    // Return on Ad Spend (value / cost)
  searchImpressionShare Float    @default(0) // Impression share percentage
  createdAt             DateTime @default(now())

  @@index([campaignId])
  @@index([date])
}

model KeywordMetrics {
  id           String   @id @default(cuid())
  campaignId   String
  keyword      String
  matchType    String   // EXACT, PHRASE, BROAD
  impressions  Int
  clicks       Int
  cost         Float
  conversions  Float
  cpc          Float
  qualityScore Int?
  createdAt    DateTime @default(now())

  @@index([campaignId])
}

model AiConsultation {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  promptType       String   @default("AUDIT") // AUDIT, BID_OPTIMIZATION, COPYWRITING, NEGATIVE_KEYWORDS
  contextData      String   // JSON string of campaign/keyword data analyzed
  aiRecommendation String   // Markdown recommendation from Gemini
  createdAt        DateTime @default(now())
}

model AccountSetting {
  id           String    @id @default(cuid())
  customerId   String    @unique
  accountName  String
  currency     String    @default("USD")
  timeZone     String    @default("America/New_York")
  isDemo       Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Lead {
  id                String    @id @default(cuid())
  source            String    // GOOGLE_ADS, GOOGLE_LSA, GOOGLE_BUSINESS, ORGANIC, DIRECT
  campaignId        String?
  campaignName      String?
  
  // ValueTrack & Granular Tracking DNA
  keyword           String?   // Exact search term from Google
  gclid             String?   // Google Click ID for Offline Conversion tracking
  matchType         String?   // Exact (e), Phrase (p), Broad (b)
  device            String?   // Mobile (m), Desktop (c), Tablet (t)
  city              String?
  state             String?

  // Contact Info & US Legal Compliance
  name              String
  email             String?
  phone             String?
  address           String?
  zipCode           String?
  tcpaConsent       Boolean   @default(true) // Telephone Consumer Protection Act opt-in
  serviceInterested String?   // e.g. "Pintura Externa", "Armários de Cozinha", "Pintura Comercial"
  serviceType       String?   // US service category
  tags              String?   @default("[]") // JSON string of tags: ["lead_convertido", "orcamento_enviado"]
  stripeCheckoutUrl String?   // Dynamic Stripe payment checkout link
  stripePaymentStatus String? @default("UNPAID") // UNPAID, PENDING, PAID
  
  // Pipeline, Ownership & Speed-to-Lead Gamification
  status            String    @default("NOVO") // NOVO, EM_ATENDIMENTO, PROPOSTA, CONVERTIDO, PERDIDO
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id])
  
  // Timing & Financial SLA Metrics
  claimedAt         DateTime? // Exact time a consultant grabbed the lead (speed-to-lead SLA)
  closedAt          DateTime? // Time the deal was won/lost
  dealValue         Float?    // Monetary deal value in USD ($)
  
  notes             String?
  aiScore           Int?      // 1 to 10
  aiQualification   String?   // Gemini summary of lead intent
  whatsappScript    String?   // Suggested WhatsApp/SMS message generated by Gemini
  rawData           String    @default("{}") // JSON string of full payload received
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([source])
  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

model CallLog {
  id              String   @id @default(cuid())
  leadId          String
  agentId         String
  agentName       String?
  durationSeconds Int
  recordingUrl    String?
  aiTranscript    String?  // Call transcript & summary from Gemini
  sentiment       String?  // POSITIVE, NEUTRAL, OBJECTION
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([agentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CLAIM_LEAD, STATUS_CHANGE, DEAL_WON, TCPA_RECORD
  userId    String
  userName  String?
  details   String   // JSON string with details of what changed
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}


