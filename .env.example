# ==============================================================================
# TONY'S PAINTING AND REMODELING - CONFIGURAÇÕES DO SISTEMA (.env)
# Copie este arquivo para .env e preencha com suas credenciais de produção
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE & APLICAÇÃO
# ------------------------------------------------------------------------------
NODE_ENV=production
AUTH_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria_aqui
AUTH_ORIGIN=https://app.tonyspainting.com
PORT=3000

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (Prisma)
# SQLite para testes locais ou PostgreSQL para produção na nuvem
# ------------------------------------------------------------------------------
# Local (Padrão atual):
DATABASE_URL="file:./dev.db"
# Produção (Ex: Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://usuario:senha@host:5432/tonys_crm?schema=public"

# ------------------------------------------------------------------------------
# 3. INTELIGÊNCIA ARTIFICIAL MULTI-AGENT (MAS)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash (Triagem ultrarrápida e scripts de abordagem)
# Google Gemini 1.5 Pro (Visão computacional de campo e cálculo de metragem)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# OpenAI GPT-4o (Copiloto do Webmail, SLA Rescue Voice, SMS Reengajamento)
# OpenAI DALL-E 3 (Geração de renders Antes/Depois para propostas)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic Claude 3.5 Sonnet (Estratégia de tráfego e contratos MA HIC)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# 4. TELEFONIA VOIP, LIGAÇÕES E SMS (Twilio)
# Obtenha em: https://console.twilio.com
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+16175550199
# Twilio TwiML App SID (Necessário para o discador VoIP WebRTC no navegador)
TWILIO_TWIML_APP_SID=APXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# 5. WEBDESK / E-MAIL CORPORATIVO (Amazon SES)
# Obtenha em: https://console.aws.amazon.com/ses
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL="Tony's Painting and Remodeling <contact@tonyspainting.com>"

# ------------------------------------------------------------------------------
# 6. PAGAMENTOS & CONTRATOS (Stripe)
# Obtenha em: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 7. GOOGLE ADS & CONVERSÕES OFFLINE
# Obtenha em: Google Ads MCC > Tools & Settings > API Center
# ------------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_CUSTOMER_ID=987-654-3210

# ------------------------------------------------------------------------------
# 8. GOOGLE REVIEWS & REPUTAÇÃO (GBP)
# Link direto de avaliação do Google Meu Negócio da sua empresa
# ------------------------------------------------------------------------------
GOOGLE_BUSINESS_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJN1t_tDeuEmsRUsoyG83frY4
